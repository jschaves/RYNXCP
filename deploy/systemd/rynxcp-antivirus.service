[Unit]
Description=RYNXCP filesystem antivirus scan
After=clamav-daemon.service
Requires=clamav-daemon.service

[Service]
Type=oneshot
ExecStart=/usr/bin/clamdscan --fdpass --multiscan --infected /home
ExecStart=/usr/bin/clamdscan --fdpass --multiscan --infected /var/vmail
Nice=10
IOSchedulingClass=idle
