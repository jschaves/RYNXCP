# RYNXCP web API configuration (production).
# The API runs unprivileged and only speaks CBOR to rynxd over a Unix socket.

bind = "127.0.0.1:8080"
database = "/var/lib/rynxcp/panel/panel.db"
web_root = "/usr/share/rynxcp/web"

daemon_socket = "/run/rynxcp/rynxd.sock"
daemon_token_file = "/etc/rynxcp/daemon.token"

# Set to true when the panel is served over HTTPS (recommended).
secure_cookies = true
session_ttl_secs = 28800
# Enable when Nginx proxies the API. Nginx must overwrite X-Real-IP with
# $remote_addr; the API never trusts the client-controlled X-Forwarded-For
# prefix.
trust_proxy_headers = false
# public_url = "https://panel.example.com"

# ---- transactional panel email (local Postfix) ----
# Used for credential delivery, password resets and certificate alerts.
# The pre-installer enables this for FQDN hosts and publishes SPF/DKIM/DMARC.
smtp_enabled = false
smtp_host = "127.0.0.1"
smtp_port = 25
# smtp_from = "noreply@panel.example.com"
# smtp_alert_to = "admin@panel.example.com"
# Only "none" is supported: the loopback hop is trusted and not encrypted.
smtp_tls = "none"

log_level = "info,tower_http=info"

# ---- brute-force protection ----
login_max_attempts = 8
login_ip_max_attempts = 30
login_window_secs = 300
login_lockout_secs = 900
auth_log = "/var/log/rynxcp/auth.log"

# ---- password policy for panel users ----
password_min_len = 12
password_min_classes = 3

# ---- sessions ----
session_idle_secs = 3600

